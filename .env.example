# 面板登录密码（必填，至少 8 位）
FRPC_WEBUI_PASSWORD=change-this-to-a-strong-password

# 面板登录用户名
# FRPC_WEBUI_USERNAME=admin

# 对外映射的面板端口
# WEBUI_PORT=8080

# 使用的 GHCR 镜像标签：latest / 1.0.0 / v1.0.0
# IMAGE_TAG=latest

# 时区
# TZ=Asia/Shanghai

# 通过 HTTPS 反向代理访问时设为 true
# COOKIE_SECURE=false

# 位于反向代理之后时设为 true，以获取真实客户端 IP（登录限流需要）
# TRUST_PROXY=false

# 反向代理改写了 Host 时，用逗号分隔允许的来源，例如 https://frp.example.com
# ALLOWED_ORIGINS=

# 构建镜像时使用的 frp 版本与下载地址（国内可换成镜像站）
# FRP_VERSION=0.71.1
# FRP_DOWNLOAD_BASE=https://github.com/fatedier/frp/releases/download
